# LLM Provider: "anthropic", "openai", or "gemini"
LLM_PROVIDER=anthropic

# API Keys — get one from your chosen provider's dashboard.
# Anthropic: https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Optional model overrides. Provider-specific stable defaults are used when blank.
# MATCH_MODEL=
# VISION_MODEL=

# Notifications: "desktop", "email", or "telegram"
NOTIFY_METHOD=telegram
NOTIFY_EMAIL=customer@example.com

# Email notifications (only if NOTIFY_METHOD=email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Telegram — required for approvals on scheduled (headless) runs.
# 1. Message @BotFather -> /newbot -> copy the token
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Legacy setting retained for compatibility. Jobs always require Telegram approval,
# even if an existing environment sets this to false.
REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_MINUTES=60

# When a form asks something not in profile.md, the agent asks you on
# Telegram and waits this long for a reply. Answers are saved to
# learned_answers.md and reused on future forms automatically.
FIELD_QUESTION_TIMEOUT_MINUTES=30

# Paths are resolved relative to this repository unless absolute.
DB_PATH=state.db
PROFILE_PATH=profile.md
LEARNED_ANSWERS_PATH=learned_answers.md
SEARCH_CONFIG_PATH=search.yaml
APPLICATIONS_DIR=applications

# Max application packages/attempts per run. Discovery caps are in search.yaml.
MAX_APPLICATIONS_PER_RUN=5

# SALTO account — for login-gated listings and native SALTO application forms.
SALTO_EMAIL=
SALTO_PASSWORD=

# Optional job-source keys (enable these sources in search.yaml).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
HIMALAYAS_API_KEY=
